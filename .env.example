# Server Environment Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database & Cache
MONGODB_URI=mongodb://localhost:27017/trustgo_db
REDIS_URL=redis://localhost:6379

# JWT Authentication Secrets (Must be at least 32 characters in production)
JWT_ACCESS_SECRET=trustgo_access_jwt_secret_dev_32char_key_min!
JWT_REFRESH_SECRET=trustgo_refresh_jwt_secret_dev_32char_key_min!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie Security
COOKIE_SECRET=trustgo_cookie_secret_dev_key_secure_32chars!

# Email Service (SMTP)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_smtp_user
EMAIL_PASSWORD=your_smtp_password
EMAIL_FROM=no-reply@trustgo.com

# Cloud Storage (Cloudinary / S3 fallback)
CLOUDINARY_CLOUD_NAME=demo_cloud
CLOUDINARY_API_KEY=demo_api_key
CLOUDINARY_API_SECRET=demo_api_secret
STORAGE_BUCKET=trustgo-secure-vault

# Rate Limiting & Abuse Prevention
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info
